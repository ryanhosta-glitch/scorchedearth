function tickLightningFires(dt){
 if(!settings.hostile){WEATHER.groundFires.length=0;return;}
 if(!WEATHER.groundFires.length)return;
 // Slow the burn while a human is deciding; otherwise a player could die while
 // reading the HUD. Damaging strikes/ground fires occur ONLY in hostile mode.
 const elapsed=dt;
 const burnDt=dt*(phase==='aim'&&!isCpu(current())?.15:1);
 for(let i=WEATHER.groundFires.length-1;i>=0;i--){
  const f=WEATHER.groundFires[i];f.life-=elapsed;
  if(f.life<=0){WEATHER.groundFires.splice(i,1);continue;}
  // Small, short-range grass fires sometimes creep one cell farther outward.
  if(f.max===3.5&&f.life>1.0&&WEATHER.groundFires.length<130&&Math.random()<elapsed*.075){
   const direction=Math.sign(f.x-f.origin)||pick([-1,1]);
   const nx=clamp(f.x+direction*2,1,W-2);
   if(Math.abs(nx-f.origin)<=13)
    WEATHER.groundFires.push({x:nx,y:ground(nx)-1,life:.75,max:.75,strength:f.strength*.5,seed:rng(0,100),origin:f.origin});
  }
 }

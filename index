    gain.gain.setValueAtTime(.0001,now);gain.gain.exponentialRampToValueAtTime(.13,now+.015);gain.gain.exponentialRampToValueAtTime(.0001,now+.62);
    const lowpass=audio.createBiquadFilter();lowpass.type='lowpass';lowpass.frequency.value=650;

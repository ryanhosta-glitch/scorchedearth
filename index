function speechWrap(text,max=33){
 const words=String(text||'').split(/\s+/).filter(Boolean),lines=[];let line='';
 for(let word of words){
   while(word.length>max){if(line){lines.push(line);line='';}lines.push(word.slice(0,max));word=word.slice(max);}
   if(!word)continue;
   const proposed=line?line+' '+word:word;
   if(proposed.length>max&&line){lines.push(line);line=word;}else line=proposed;
 }
 if(line)lines.push(line);
 if(lines.length>5){const result=lines.slice(0,5);result[4]=result[4].slice(0,Math.max(0,max-1))+'…';return result;}
 return lines;
}

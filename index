    const length=Math.floor(audio.sampleRate*.55),buffer=audio.createBuffer(1,length,audio.sampleRate),data=buffer.getChannelData(0);
    let v=0;for(let i=0;i<length;i++){v=(Math.random()*2-1)*.65+v*.35;data[i]=v*(1-i/length)}

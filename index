// SCORCH v16: Shield charge accounting and physics.
// Current shields are independent of unused purchased cartridges; switching
// stores the current partially used field for later retrieval.
const SHIELD_STATS={absorbed:0,reflected:0,magneticDeflections:0,breakdowns:0,switched:0,reinforced:0};
const SHIELD_BREAKS=[.75,.5,.25,0];
function ensureShieldInventory(p){p.shieldStock=p.shieldStock||{};p.shieldHeld=p.shieldHeld||{};}
function shieldGear(id){return GEAR.find(w=>w.id===id&&w.shield)||null;}
function shieldMax(p){return shieldGear(p.shieldType)?.shield||0;}
function shieldAvailable(p,id){ensureShieldInventory(p);return (p.shieldHeld[id]||0)>0||(p.shieldStock[id]||0)>0;}
function ownedShieldKinds(p){ensureShieldInventory(p);return GEAR.filter(w=>w.shield&&(shieldAvailable(p,w.id)||(p.shield>0&&p.shieldType===w.id)));}
function shieldActivation(p,id,opts={}){
 const w=shieldGear(id);if(!p||!p.alive||!w)return false;
 ensureShieldInventory(p);
 if(p.shieldType===id&&p.shield>0)return false;
 let energy=0;
 if(p.shieldHeld[id]>0){energy=p.shieldHeld[id];delete p.shieldHeld[id];}
 else if(p.shieldStock[id]>0){p.shieldStock[id]--;energy=w.shield;}
 if(energy<=0)return false;
 if(p.shield>0&&p.shieldType)p.shieldHeld[p.shieldType]=p.shield;
 p.shield=energy;p.shieldType=id;
 SHIELD_STATS.switched++;
 if(!opts.quiet){playShieldEngage(id);log('SHIELD '+p.name+' engaged '+w.name+' ('+Math.ceil(energy)+' charge)');}
 if(!opts.noRefresh&&phase==='aim')refresh();
 return true;
}
function stowShield(p){if(!p||!p.alive||!(p.shield>0))return false;ensureShieldInventory(p);p.shieldHeld[p.shieldType]=p.shield;log('SHIELD '+p.name+' stored '+p.shieldType);p.shield=0;p.shieldType='';playShieldDowngrade();if(phase==='aim')refresh();return true;}
function bestSpareShield(p){ensureShieldInventory(p);return GEAR.filter(w=>w.shield&&shieldAvailable(p,w.id)).sort((a,b)=>b.shield-a.shield)[0];}
function automaticReplacement(p){if(!p.autoDefense||!p.alive||p.shield>0)return false;const w=bestSpareShield(p);return w?shieldActivation(p,w.id,{noRefresh:true}):false;}
function drainShield(p,amount,reason='impact'){
 if(!(p.shield>0)||!(amount>0))return 0;
 const prev=p.shield,max=shieldMax(p)||100;
 const used=Math.min(prev,amount);p.shield=Math.max(0,prev-used);
 if(SHIELD_BREAKS.some(b=>prev/max>b&&p.shield/max<=b)){
   playShieldDowngrade();log('SHIELD '+p.name+' '+(p.shield>0?Math.round(100*p.shield/max)+'%':'EXHAUSTED'));
 }
 if(p.shield<=0){SHIELD_STATS.breakdowns++;p.shieldType='';automaticReplacement(p);}
 return used;
}
function playShieldEngage(id){if(!soundLevel())return;const mag=['mag','supermag'].includes(id);soundOsc(mag?340:620,mag?920:1160,.23,'triangle',.051);soundOsc(mag?570:780,mag?1400:960,.25,'sine',.024,.04);}
function playShieldBounce(type){if(!soundLevel())return;playShieldHit();if(type==='forceShield'){soundOsc(260,840,.25,'triangle',.061);soundOsc(610,210,.19,'sine',.03,.03)}else if(type==='mag'||type==='supermag'){soundOsc(810,290,.18,'sawtooth',.027)}}
const SHIELD_COLLISION={absorbingDetonations:0,kineticHits:0,hullOverflow:0,bottomWallHits:0};
function directShieldImpact(target,charge,owner,reason){
 let remaining=Math.max(0,charge),absorbed=0,tries=0;
 // Purchased Auto Defense cartridges may engage as earlier fields run dry.
 while(remaining>.001&&target.shield>0&&tries++<20){
   const removed=drainShield(target,remaining,reason);
   absorbed+=removed;remaining-=removed;
   if(removed<=0)break;
 }
 let hull=0;
 if(remaining>.001){
   const hpBefore=target.hp;target.hp=Math.max(0,hpBefore-remaining);hull=hpBefore-target.hp;
   target.power=Math.min(target.power,hpCap(target));
   SHIELD_COLLISION.hullOverflow+=hull;
   if(target.hp<=0)destroyTank(target);else if(hull>=5)showTaunt(target,'hurt');
 }
 creditHit(owner,target,hull,absorbed);
 return {absorbed,hull};
}
function shieldContact(proj){
 if(proj.y<0||!proj.weapon)return null;
 for(const q of players){
  if(!q.alive||!(q.shield>0)||players[proj.owner]===q)continue;
  const type=q.shieldType,rad=(type==='supermag'?15.5:type==='heavyShield'?13:12),dx=proj.x-q.x,dy=proj.y-(q.y-3),d=Math.hypot(dx,dy);
  if(d<.5||d>rad)continue;
  // This is geometric incoming/outgoing detection, not friend/enemy targeting.
  const incoming=(proj.vx*dx+proj.vy*dy)<0;
  if(!incoming)continue;
  const normalX=dx/d,normalY=dy/d;
  const hitSpeed=Math.hypot(proj.vx||0,proj.vy||0);
  const basePower=Math.max(4,Number(proj.weapon.damage)||4);
  const blastSize=Math.max(0,Number(proj.weapon.radius)||0);
  const impact=Math.max(6,(basePower*.84+blastSize*.26+Math.min(220,hitSpeed)*.018)*(type==='heavyShield'?.77:1));
  SHIELD_COLLISION.kineticHits++;
  if(type==='forceShield'||type==='supermag'){
    const dot=proj.vx*normalX+proj.vy*normalY;
    const strength=type==='forceShield'?.84:1.02;
    proj.vx=(proj.vx-2*dot*normalX)*strength;
    proj.vy=(proj.vy-2*dot*normalY)*strength-((type==='supermag')?17:3);
    proj.x=q.x+normalX*(rad+1.2);proj.y=(q.y-3)+normalY*(rad+1.2);

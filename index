 if(!text)return '';
 p.lastTalkAt=now;
 for(let i=taunts.length-1;i>=0;i--)if(taunts[i].p===p)taunts.splice(i,1);
 taunts.push({p,text,life:kind==='death'||kind==='win'?4.0:3.3,kind,persona:p.persona||'Computer'});

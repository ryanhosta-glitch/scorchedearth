  if(p.shield>0){const absorbed=drainShield(p,damage,'lightning ground fire');damage-=absorbed;WEATHER.stats.shieldAbsorbed+=absorbed;}
  if(damage>0){const loss=Math.min(p.hp,damage);p.hp=Math.max(0,p.hp-loss);p.power=Math.min(p.power,hpCap(p));WEATHER.stats.hullDamage+=loss;WEATHER.stats.groundBurnDamage+=loss;

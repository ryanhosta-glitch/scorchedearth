function talkLine(p,kind){
 const persona=PERSONAS[p.persona]||PERSONAS['Mad Scientist'];const lines=persona[kind]||persona.attack;if(p.persona!=='Unhinged'&&(kind==='attack'||kind==='death')&&Math.random()<.07){const extras=kind==='attack'?customAttackLines:customDeathLines;if(extras?.length)return pick(extras);}

 const minimum=kind==='attack'?1.3:kind==='death'||kind==='win'?.05:kind==='hit'||kind==='miss'?.6:2.0;
 if(!force&&p.lastTalkAt!=null&&now-p.lastTalkAt<minimum)return '';
